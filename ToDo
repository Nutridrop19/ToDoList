<body>

<div class="container">

<h1>📝 My Tasks</h1>

<div class="input-area">
<input id="taskInput" placeholder="Mau ngerjain apa hari ini...">
<button class="add" onclick="addTask()">Tambah</button>
</div>

<input id="search" class="search" placeholder="Cari tugas..." onkeyup="render()">

<div class="progress-box">
<div class="info">
<span id="count">0 / 0 selesai</span>
<span id="percent">0%</span>
</div>

<div class="progress">
<span id="bar"></span>
</div>
</div>

<ul id="list"></ul>

</div>

<script>

let tasks=JSON.parse(localStorage.getItem("todo"))||[];

function save(){
localStorage.setItem("todo",JSON.stringify(tasks));
render();
}

function addTask(){

let input=document.getElementById("taskInput");

if(input.value.trim()=="") return;

tasks.unshift({
text:input.value,
done:false
});

input.value="";
save();

}

function render(){

let keyword=document.getElementById("search").value.toLowerCase();

let list=document.getElementById("list");

list.innerHTML="";

let filtered=tasks.filter(x=>x.text.toLowerCase().includes(keyword));

if(filtered.length==0){
list.innerHTML="<div class='empty'>Belum ada tugas 😴</div>";
}

filtered.forEach(task=>{

let realIndex=tasks.indexOf(task);

list.innerHTML+=`
<li>

<div class="left">

<input class="check"
type="checkbox"
${task.done?"checked":""}
onchange="toggle(${realIndex})">

<div class="text ${task.done?"done":""}">
${task.text}
</div>

</div>

<div class="actions">

<button class="edit"
onclick="editTask(${realIndex})">
Edit
</button>

<button class="delete"
onclick="removeTask(${realIndex})">
Hapus
</button>

</div>

</li>
`;

});

updateProgress();

}

function toggle(i){
tasks[i].done=!tasks[i].done;
save();
}

function removeTask(i){
tasks.splice(i,1);
save();
}

function editTask(i){

let baru=prompt("Edit tugas",tasks[i].text);

if(baru && baru.trim()!=""){
tasks[i].text=baru;
save();
}

}

function updateProgress(){

let done=tasks.filter(x=>x.done).length;

let total=tasks.length;

let percent=total?Math.round(done/total*100):0;

document.getElementById("count").innerHTML=`${done} / ${total} selesai`;

document.getElementById("percent").innerHTML=percent+"%";

document.getElementById("bar").style.width=percent+"%";

}

document.getElementById("taskInput").addEventListener("keypress",e=>{
if(e.key==="Enter") addTask();
});

render();

</script>

</body>
