<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Todo</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:linear-gradient(135deg,#0f172a,#1e293b,#2563eb);
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
padding:30px;
}

.container{
width:100%;
max-width:760px;
background:rgba(255,255,255,.08);
backdrop-filter:blur(20px);
border:1px solid rgba(255,255,255,.1);
border-radius:24px;
padding:30px;
color:white;
box-shadow:0 15px 50px rgba(0,0,0,.35);
}

h1{
font-size:32px;
margin-bottom:20px;
}

.input-box{
display:flex;
gap:10px;
margin-bottom:20px;
}

input{
flex:1;
padding:15px;
border:none;
outline:none;
border-radius:15px;
background:rgba(255,255,255,.08);
color:white;
font-size:15px;
}

input::placeholder{
color:#d1d5db;
}

button{
border:none;
cursor:pointer;
border-radius:15px;
padding:14px 18px;
font-weight:600;
transition:.25s;
}

button:hover{
transform:translateY(-2px);
}

.add{
background:#2563eb;
color:white;
}

.search{
margin-bottom:20px;
}

.progress-info{
display:flex;
justify-content:space-between;
margin-bottom:8px;
font-size:14px;
color:#ddd;
}

.progress{
height:10px;
border-radius:50px;
background:rgba(255,255,255,.1);
overflow:hidden;
margin-bottom:20px;
}

.bar{
height:100%;
width:0%;
background:linear-gradient(90deg,#22c55e,#4ade80);
transition:.3s;
}

ul{
list-style:none;
}

li{
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(255,255,255,.08);
padding:15px;
margin-bottom:12px;
border-radius:16px;
cursor:grab;
transition:.2s;
}

li:hover{
background:rgba(255,255,255,.12);
}

.left{
display:flex;
align-items:center;
gap:12px;
flex:1;
}

.drag{
font-size:22px;
opacity:.5;
cursor:grab;
user-select:none;
}

.done{
text-decoration:line-through;
opacity:.45;
}

.actions button{
padding:8px 12px;
margin-left:5px;
border-radius:10px;
}

.edit{
background:#f59e0b;
color:white;
}

.delete{
background:#ef4444;
color:white;
}

.ghost{
opacity:.35;
background:#3b82f6!important;
}

.empty{
text-align:center;
padding:35px;
opacity:.6;
}

</style>

</head>
<body>

<div class="container">

<h1>📝 My Todo</h1>

<div class="input-box">

<input id="taskInput" placeholder="Tambah tugas...">

<button class="add" onclick="addTask()">
Tambah
</button>

</div>

<input id="search" class="search" placeholder="Cari tugas..." onkeyup="render()">

<div class="progress-info">

<span id="count">0 / 0 selesai</span>

<span id="percent">0%</span>

</div>

<div class="progress">
<div class="bar" id="bar"></div>
</div>

<ul id="list"></ul>

</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<script>

let tasks=JSON.parse(localStorage.getItem("todo"))||[];

function save(){

localStorage.setItem("todo",JSON.stringify(tasks));

render();

}

function addTask(){

const input=document.getElementById("taskInput");

if(input.value.trim()=="")return;

tasks.unshift({

text:input.value,

done:false

});

input.value="";

save();

}

function toggle(i){

tasks[i].done=!tasks[i].done;

save();

}

function removeTask(i){

tasks.splice(i,1);

save();

}

function editTask(i){

const baru=prompt("Edit tugas",tasks[i].text);

if(baru && baru.trim()!=""){

tasks[i].text=baru;

save();

}

}

function updateProgress(){

const done=tasks.filter(x=>x.done).length;

const total=tasks.length;

const persen=total?Math.round(done/total*100):0;

document.getElementById("count").innerHTML=`${done} / ${total} selesai`;

document.getElementById("percent").innerHTML=persen+"%";

document.getElementById("bar").style.width=persen+"%";

}

function render(){

const keyword=document.getElementById("search").value.toLowerCase();

const list=document.getElementById("list");

list.innerHTML="";

const filtered=tasks.filter(t=>t.text.toLowerCase().includes(keyword));

if(filtered.length==0){

list.innerHTML="<div class='empty'>Belum ada tugas.</div>";

}

filtered.forEach(task=>{

const realIndex=tasks.indexOf(task);

list.innerHTML+=`

<li>

<div class="left">

<span class="drag">☰</span>

<input type="checkbox"

${task.done?"checked":""}

onchange="toggle(${realIndex})">

<span class="${task.done?"done":""}">

${task.text}

</span>

</div>

<div class="actions">

<button class="edit"

onclick="editTask(${realIndex})">

Edit

</button>

<button class="delete"

onclick="removeTask(${realIndex})">

Hapus

</button>

</div>

</li>

`;

});

updateProgress();

new Sortable(document.getElementById("list"),{

animation:180,

ghostClass:"ghost",

handle:".drag",

onEnd:function(evt){

if(document.getElementById("search").value!=""){

alert("Kosongkan pencarian dulu sebelum mengubah urutan.");

render();

return;

}

const item=tasks.splice(evt.oldIndex,1)[0];

tasks.splice(evt.newIndex,0,item);

localStorage.setItem("todo",JSON.stringify(tasks));

}

});

}

document.getElementById("taskInput").addEventListener("keypress",function(e){

if(e.key==="Enter")addTask();

});

render();

</script>

</body>
</html>
